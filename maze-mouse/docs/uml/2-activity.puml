@startuml activity
title Диаграмма деятельности — обучение мыши (Q-learning)

start
:Получить лабиринт\n(генерация или схема пользователя);
if (Схема корректна?) then (нет)
  :Показать ошибки проверки;
  stop
else (да)
endif
:Создать сессию: среда + агент\nQ(s,a) := initialQ, ε := ε₀;
repeat :Эпизод k;
  :Сбросить среду:\nмышь на старте, вода не выпита, Σ := 0;
  repeat
    if (случайное < ε?) then (да — исследование)
      :a := случайное направление;
    else (нет — использование опыта)
      :a := argmax Q(s, ·);
    endif
    :Среда выполняет действие a;
    switch (Клетка назначения)
    case (стена)
      :r := штраф за стену\nмышь на месте;
    case (вода, не выпита)
      :r := шаг + x\nотметить воду выпитой;
    case (электроток)
      :r := шаг − y;
    case (сыр)
      :r := шаг + Z\nэпизод завершён;
    case (проход)
      :r := шаг;
    endswitch
    :Σ := Σ + r  (обратная связь);
    :Q(s,a) += α·(r + γ·max Q(s',·) − Q(s,a));
    :s := s';
  repeat while (сыр не найден и лимит шагов не исчерпан?) is (да)
  :Записать статистику эпизода;
  :ε := max(ε_min, ε · decay);
repeat while (k < N и не нажат «Стоп»?) is (да)
:Показать проход по выученной политике\n(жадно, без обучения);
stop
@enduml
