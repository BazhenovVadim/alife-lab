@startuml state
!pragma layout smetana
title Диаграмма состояний — мышь в эпизоде

[*] --> НаСтарте : reset()
НаСтарте --> ВыбираетДействие

state ВыбираетДействие : ε-жадный выбор a
ВыбираетДействие --> УдариласьОСтену : клетка — стена
ВыбираетДействие --> Движется : проход
ВыбираетДействие --> ПьётВоду : вода, ещё не выпита
ВыбираетДействие --> ПолучилаТравму : электроток
ВыбираетДействие --> НашлаСыр : сыр

state УдариласьОСтену : r = штраф за стену
state Движется : r = цена шага
state ПьётВоду : r = шаг + x\nбит воды в маске := 1
state ПолучилаТравму : r = шаг − y

УдариласьОСтену --> Обучается
Движется --> Обучается
ПьётВоду --> Обучается
ПолучилаТравму --> Обучается

state Обучается : Q(s,a) ← Q(s,a) + α·δ\nΣ += r
Обучается --> ВыбираетДействие : шаги < лимита
Обучается --> Прервана : шаги = лимит

state НашлаСыр : r = шаг + Z\nQ(s,a) ← Q(s,a) + α·(r − Q(s,a))
НашлаСыр --> [*] : terminal
Прервана --> [*] : truncated
@enduml
